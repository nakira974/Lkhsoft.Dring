<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Lkhsoft.Dring.Client.PageModels"
             x:Class="Lkhsoft.Dring.Client.Pages.LoginPage"
             x:DataType="pageModels:LoginPageModel"
             Title="Login">
    <StackLayout Padding="20">
        <!-- Champ pour l'username -->
        <Entry Placeholder="User name" Text="{Binding UserName}" />

        <!-- Champ pour le mot de passe -->
        <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" />

        <!-- Bouton de connexion -->
        <Button Text="Login" Command="{Binding LoginCommand}" />

        <!-- Message d'erreur -->
        <Label Text="{Binding AuthErrorMessage}" TextColor="Red" IsVisible="{Binding IsErrorMessageVisible}" />
    </StackLayout>
</ContentPage>