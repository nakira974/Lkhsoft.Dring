<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Lkhsoft.Dring.Client.PageModels"
             x:Class="Lkhsoft.Dring.Client.Pages.AudioStreamTest"
             x:DataType="pageModels:AudioStreamPageModel"
             Title="Audio Stream Test">

    <ContentPage.Content>
        <VerticalStackLayout Padding="20" Spacing="10">
            <!-- Sélection du périphérique audio -->
            <Label Text="Select Audio Device:" />
            <Picker ItemsSource="{Binding AudioDevices}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}" />

            <!-- Bouton pour démarrer l'envoi des données -->
            <Button Text="Start Streaming"
                    Command="{Binding StartStreamingCommand}"
                    IsEnabled="{Binding IsNotStreaming}" />

            <!-- Bouton pour arrêter l'envoi des données -->
            <Button Text="Stop Streaming"
                    Command="{Binding StopStreamingCommand}"
                    IsEnabled="{Binding IsStreaming}" />

            <!-- Indicateur de statut -->
            <Label Text="{Binding StatusMessage}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>